{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:actunode:schema:vda5050:header",
  "title": "VDA 5050 message header (ActuNode subset)",
  "type": "object",
  "required": ["headerId", "timestamp", "version", "manufacturer", "serialNumber"],
  "properties": {
    "headerId": { "type": "integer", "minimum": 0 },
    "timestamp": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "manufacturer": { "type": "string", "minLength": 1 },
    "serialNumber": { "type": "string", "minLength": 1 }
  }
}
